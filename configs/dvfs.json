{
  "description": "SXM-only DVFS sweep: approximately90MHz graphics grid in discovered supported ranges at every advertised memory domain; includes exact1110MHz when supported, advertised default fixedpair and incoming-policy reference. Replace geometry with measured per-GPU saturation conditions.",
  "seconds": 12,
  "warmup_seconds": 3,
  "idle_seconds": 6,
  "repeats": 4,
  "sample_interval_s": 0.05,
  "clock_sweep": {
    "graphics_step_mhz": 90,
    "required_graphics_mhz": [
      1110
    ],
    "all_memory_clocks": true,
    "include_default_policy": true,
    "include_advertised_default": true
  },
  "experiments": [
    {
      "workload": "control",
      "stage": "dvfs",
      "parameters": {
        "blocks": "sm_count*4",
        "threads": 256
      }
    },
    {
      "workload": "tensor",
      "stage": "dvfs",
      "parameters": {
        "blocks": "sm_count*4",
        "threads": 256,
        "tensor_accumulators": 4
      }
    },
    {
      "workload": "gemm",
      "stage": "dvfs",
      "parameters": {
        "gemm_m": 4096,
        "gemm_n": 4096,
        "gemm_k": 4096
      }
    },
    {
      "workload": "l1",
      "stage": "dvfs",
      "parameters": {
        "blocks": "sm_count*4",
        "threads": 256,
        "working_set_bytes": "sm_count*4*16384"
      }
    },
    {
      "workload": "l2",
      "stage": "dvfs",
      "parameters": {
        "blocks": "sm_count*4",
        "threads": 256,
        "working_set_bytes": "l2_bytes*0.5"
      }
    },
    {
      "workload": "hbm",
      "stage": "dvfs",
      "parameters": {
        "blocks": "sm_count*4",
        "threads": 256,
        "working_set_bytes": "max(l2_bytes*8,268435456)",
        "seed": 2026
      }
    }
  ],
  "target_form_factor": "SXM",
  "paired_reference": true
}
