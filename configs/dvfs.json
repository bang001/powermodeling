{
  "description": "SXM energy sweep from 900 MHz with configurable advertised-clock intervals (default 90 MHz), factory default fixed pair, incoming-policy reference and exact 1110 MHz wherever supported. Inspect plan runtime and evaluation coverage.",
  "seconds": 12,
  "warmup_seconds": 3,
  "idle_seconds": 6,
  "repeats": 4,
  "sample_interval_s": 0.05,
  "clock_sweep": {
    "graphics_step_mhz": 90,
    "all_memory_clocks": true,
    "required_graphics_mhz": [
      1110
    ],
    "include_default_policy": true,
    "include_advertised_default": true,
    "graphics_min_mhz": 900
  },
  "experiments": [
    {
      "workload": "control",
      "stage": "dvfs",
      "parameters": {},
      "grid": {
        "blocks": [
          "sm_count*2",
          "sm_count*4",
          "sm_count*8"
        ],
        "threads": [
          128,
          256
        ]
      }
    },
    {
      "workload": "tensor",
      "stage": "dvfs",
      "parameters": {
        "tensor_accumulators": 4
      },
      "grid": {
        "blocks": [
          "sm_count*2",
          "sm_count*4",
          "sm_count*8"
        ],
        "threads": [
          128,
          256
        ]
      }
    },
    {
      "workload": "gemm",
      "stage": "dvfs",
      "parameters": {
        "gemm_n": 4096,
        "gemm_k": 4096
      },
      "grid": {
        "gemm_m": [
          2048,
          4096,
          8192
        ]
      }
    },
    {
      "workload": "l1",
      "stage": "dvfs",
      "parameters": {
        "working_set_bytes": "blocks*16384"
      },
      "grid": {
        "blocks": [
          "sm_count*2",
          "sm_count*4",
          "sm_count*8"
        ],
        "threads": [
          128,
          256
        ]
      }
    },
    {
      "workload": "l2",
      "stage": "dvfs",
      "parameters": {
        "working_set_bytes": "l2_bytes*0.5"
      },
      "grid": {
        "blocks": [
          "sm_count*2",
          "sm_count*4",
          "sm_count*8"
        ],
        "threads": [
          128,
          256
        ]
      }
    },
    {
      "workload": "hbm",
      "stage": "dvfs",
      "parameters": {
        "working_set_bytes": "max(l2_bytes*8,268435456)",
        "seed": 2026
      },
      "grid": {
        "blocks": [
          "sm_count*2",
          "sm_count*4",
          "sm_count*8"
        ],
        "threads": [
          128,
          256
        ]
      }
    }
  ],
  "target_form_factor": "SXM",
  "paired_reference": true,
  "study_design": "energy_sweep"
}
