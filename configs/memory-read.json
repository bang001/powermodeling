{
  "description": "Coalesced scalar-read energy sweep for L1, L2 and HBM only: stride_words=1 gives adjacent 4-byte lane addresses and expected 100% requested-sector efficiency with aligned full warps. Require separate counter-backed coalescing and target-path evidence before energy selection. Stride/offset diagnostics are separate. Graphics clocks start near 900 MHz, default90 MHz intervals, exact1110 and advertised factory default anchors.",
  "seconds": 12,
  "warmup_seconds": 3,
  "idle_seconds": 6,
  "repeats": 4,
  "sample_interval_s": 0.05,
  "clock_sweep": {
    "graphics_step_mhz": 90,
    "all_memory_clocks": true,
    "required_graphics_mhz": [
      1110
    ],
    "include_default_policy": true,
    "include_advertised_default": true,
    "graphics_min_mhz": 900
  },
  "experiments": [
    {
      "workload": "l1",
      "stage": "memory_read",
      "parameters": {
        "working_set_bytes": "blocks*16384",
        "stride_words": 1,
        "offset_bytes": 0,
        "access": "read",
        "iterations": 4096,
        "batch_launches": 16
      },
      "grid": {
        "blocks": [
          "sm_count*2",
          "sm_count*4",
          "sm_count*8"
        ],
        "threads": [
          128,
          256
        ]
      },
      "experiment_role": "energy_characterization"
    },
    {
      "workload": "l2",
      "stage": "memory_read",
      "parameters": {
        "working_set_bytes": "l2_bytes*0.5",
        "stride_words": 1,
        "offset_bytes": 0,
        "access": "read",
        "iterations": 4096,
        "batch_launches": 16
      },
      "grid": {
        "blocks": [
          "sm_count*2",
          "sm_count*4",
          "sm_count*8"
        ],
        "threads": [
          128,
          256
        ]
      },
      "experiment_role": "energy_characterization"
    },
    {
      "workload": "hbm",
      "stage": "memory_read",
      "parameters": {
        "working_set_bytes": "max(l2_bytes*8,268435456)",
        "seed": 2026,
        "stride_words": 1,
        "offset_bytes": 0,
        "access": "read",
        "iterations": 4096,
        "batch_launches": 16
      },
      "grid": {
        "blocks": [
          "sm_count*2",
          "sm_count*4",
          "sm_count*8"
        ],
        "threads": [
          128,
          256
        ]
      },
      "experiment_role": "energy_characterization"
    }
  ],
  "target_form_factor": "SXM",
  "paired_reference": true,
  "study_design": "energy_sweep"
}
