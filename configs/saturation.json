{
  "description": "SXM energy sweep from 900 MHz with configurable advertised-clock intervals (default 90 MHz), factory default fixed pair, incoming-policy reference and exact 1110 MHz wherever supported. Inspect plan runtime and evaluation coverage. Memory energy candidates use explicit stride_words=1 (4-byte lane spacing) and sector-aligned regions; strided accesses belong to diagnostic plans.",
  "seconds": 12,
  "warmup_seconds": 3,
  "idle_seconds": 6,
  "repeats": 4,
  "sample_interval_s": 0.05,
  "randomization_seed": 2026,
  "clock_sweep": {
    "graphics_step_mhz": 90,
    "all_memory_clocks": true,
    "required_graphics_mhz": [
      1110
    ],
    "include_default_policy": true,
    "include_advertised_default": true,
    "graphics_min_mhz": 900
  },
  "experiments": [
    {
      "workload": "control",
      "grid": {
        "blocks": [
          "sm_count",
          "sm_count*2",
          "sm_count*4"
        ],
        "threads": [
          128,
          256
        ]
      }
    },
    {
      "workload": "tensor",
      "grid": {
        "blocks": [
          "sm_count",
          "sm_count*2",
          "sm_count*4"
        ],
        "threads": [
          128,
          256
        ],
        "tensor_accumulators": [
          1,
          4,
          8
        ]
      }
    },
    {
      "workload": "gemm",
      "parameters": {
        "gemm_n": 4096,
        "gemm_k": 4096
      },
      "grid": {
        "gemm_m": [
          2048,
          4096,
          8192
        ]
      }
    },
    {
      "workload": "l1",
      "grid": {
        "blocks": [
          "sm_count",
          "sm_count*2",
          "sm_count*4"
        ],
        "threads": [
          128,
          256
        ],
        "working_set_bytes": [
          "blocks*16384",
          "blocks*32768",
          "blocks*65536"
        ]
      },
      "parameters": {
        "stride_words": 1,
        "offset_bytes": 0,
        "access": "read"
      },
      "experiment_role": "energy_characterization"
    },
    {
      "workload": "l2",
      "grid": {
        "blocks": [
          "sm_count",
          "sm_count*2",
          "sm_count*4"
        ],
        "threads": [
          128,
          256
        ],
        "working_set_bytes": [
          "l2_bytes*0.25",
          "l2_bytes*0.75",
          "l2_bytes*1.25"
        ]
      },
      "parameters": {
        "stride_words": 1,
        "offset_bytes": 0,
        "access": "read"
      },
      "experiment_role": "energy_characterization"
    },
    {
      "workload": "hbm",
      "parameters": {
        "working_set_bytes": "max(l2_bytes*8,268435456)",
        "seed": 2026,
        "stride_words": 1,
        "offset_bytes": 0
      },
      "grid": {
        "blocks": [
          "sm_count",
          "sm_count*2",
          "sm_count*4"
        ],
        "threads": [
          128,
          256
        ],
        "access": [
          "read",
          "copy"
        ]
      },
      "experiment_role": "energy_characterization"
    }
  ],
  "target_form_factor": "SXM",
  "paired_reference": true,
  "study_design": "energy_sweep"
}
